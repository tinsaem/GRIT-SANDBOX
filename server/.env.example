# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:tinsae@localhost:5432/givt-db

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# For Gmail: enable 2FA, generate an App Password, paste it in SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM=GIVT Platform <noreply@givt.edu>

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at console.cloud.google.com → APIs & Services → Credentials
# Authorised redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ── URLs ──────────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
# SERVER_URL is used to build the email verification link; defaults to http://localhost:PORT
# In production set this to your deployed API domain (e.g. https://api.givt.edu)
SERVER_URL=http://localhost:3000
PORT=3000
NODE_ENV=development

# ── Anthropic (AI agents) ──────────────────────────────────────────────────────
# Get a key at console.anthropic.com → API Keys. Powers all 7 in-app agents via
# server/routes/agent.js — set it and they work immediately, no code changes needed.
ANTHROPIC_API_KEY=your-anthropic-api-key
