run = "sh -c \"npm run setup && npm run dev:full\""
entrypoint = "server/index.js"
modules = ["nodejs-20", "web", "nix", "postgresql-16", "python-base-3.13"]

hidden = [".config", "package-lock.json"]

[nix]
channel = "stable-25_05"

[env]
NODE_ENV = "development"

# Full-stack app: React/Vite frontend (src/) + Express/Prisma/Postgres API (server/).
# Dev "Run": starts the Vite dev server (port 5173, proxies /api -> :3000) and the
# Express API (port 3000) together via `concurrently` (npm run dev:full).
# Deployment: builds the frontend to dist/, applies pending Prisma migrations, then
# starts a single Express process that serves both the API and the built frontend
# (see server/index.js) — one process, one port, suitable for Autoscale.
# Requires DATABASE_URL, JWT_SECRET and CLIENT_URL secrets at minimum — see
# REPLIT_DEPLOY.md for the full list and setup steps.
[deployment]
build = ["sh", "-c", "npm run setup && npm run db:generate && npm run migrate:deploy && npm run build"]
run = ["sh", "-c", "npm run start"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 3999
externalPort = 3002

[[ports]]
localPort = 4599
externalPort = 3003

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 5173
externalPort = 80

